# "mock" runs fully offline with keyword-based results; "gemini" calls the real model.
LLM_PROVIDER=mock

# Required when LLM_PROVIDER=gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# SQLAlchemy URL. SQLite file is created next to where uvicorn is started.
DATABASE_URL=sqlite:///./hirelens.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
# Optional regex for additional origins, e.g. https://hirelens[a-z0-9-]*.onrender.com
# CORS_ORIGIN_REGEX=
